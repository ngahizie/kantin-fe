# Kantin Cashless - Frontend Environment Configuration

# Backend Kantin API URL (Spring Boot kantin-be pada port 8082)
VITE_API_URL=http://localhost:8082

# Admin Backend API URL (untuk otentikasi login staf)
VITE_ADMIN_BE_URL=http://localhost:8081

# Mock API Layer (set false untuk terhubung langsung ke backend server)
VITE_USE_MOCK=false

# Nama Aplikasi
VITE_APP_NAME="Kantin Cashless"